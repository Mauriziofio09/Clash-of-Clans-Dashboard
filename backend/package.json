{
  "name": "coc-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lokaler Express-Backend-Server f\u00fcr das Clash of Clans Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --include \"./src/data/*.json\" src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:data",
    "copy:data": "node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "npm run build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
