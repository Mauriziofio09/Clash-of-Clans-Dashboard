# ---------------------------------------------------------------------------
# Clash of Clans API Zugangsdaten
# Key erstellen unter: https://developer.clashofclans.com/
# WICHTIG: Beim Erstellen des Keys muss die aktuelle oeffentliche IP
# des Laptops als "Allowed IP" hinterlegt sein, sonst antwortet die API
# mit 403 accessDenied.ip
# ---------------------------------------------------------------------------
# Der Key ist ein langer JWT und braucht KEINE Anfuehrungszeichen.
COC_API_KEY=hier_deinen_jwt_api_key_einfuegen

# Spieler-Tag, z. B. #2PP0JCVJL (Gross-/Kleinschreibung egal).
# WICHTIG: Die Raute muss in Anfuehrungszeichen stehen, sonst gilt der Rest
# der Zeile als Kommentar und der Wert kommt leer an.
#   richtig: COC_PLAYER_TAG="#2PP0JCVJL"
#   richtig: COC_PLAYER_TAG=2PP0JCVJL      (ohne Raute, wird ergaenzt)
#   falsch:  COC_PLAYER_TAG=#2PP0JCVJL     (wird als Kommentar gelesen)
COC_PLAYER_TAG="#DEINTAG"

# Optional: Clan-Tag, ebenfalls in Anfuehrungszeichen. Bleibt das Feld leer,
# wird der Clan des Spielers benutzt.
COC_CLAN_TAG=

# ---------------------------------------------------------------------------
# Server / Verhalten
# ---------------------------------------------------------------------------
PORT=3000

# Erlaubte Origins fuer CORS (Komma-getrennt) - Angular Dev-Server
CORS_ORIGIN=http://localhost:4200

# Wie lange Antworten der CoC API im Speicher gecached werden (Sekunden)
CACHE_TTL_SECONDS=60

# Timeout fuer Requests an die CoC API (Millisekunden)
COC_TIMEOUT_MS=10000

# Vorgeschlagenes Auto-Refresh-Intervall fuers Frontend (Sekunden)
REFRESH_INTERVAL_SECONDS=300

# Nur fuer Tests: abweichende Basis-URL der Spiele-API (z. B. lokaler Mock).
# Im Normalbetrieb leer lassen.
COC_API_BASE_URL=

# Pfad zur SQLite-Datei (relativ zum backend-Ordner)
DATABASE_FILE=data/dashboard.sqlite
